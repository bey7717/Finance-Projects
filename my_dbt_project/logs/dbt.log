    create view main."stg_applications" as
    -- models/stg_applications.sql
WITH source AS (
    SELECT * FROM main."raw_applications"
)

SELECT
    ID as applicant_id,
    annual_income,
    -- Convert days to years (absolute value because days are often negative in these datasets)
    ABS(employed_days) / 365.0 as years_employed,
    -- Map education to numeric within the SQL layer
    CASE 
        WHEN education = 'Higher education' THEN 1 
        ELSE 0 
    END as is_higher_ed,
    label as rejected
FROM source;
