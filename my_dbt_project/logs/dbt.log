    create view main."credit_risk" as
    -- income per child
-- annual income / # of children

SELECT Ind_ID, Annual_income, children,
CASE 
    WHEN children > 0 THEN Annual_income / children
    ELSE NULL
END AS income_per_child
FROM raw_credit_data;
